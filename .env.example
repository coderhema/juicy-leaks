# Copy to .env and fill in. Never commit .env.

# Default provider: NVIDIA NIM (build.nvidia.com), model meta/muse-glimmer-30b (Meta)
# (meta/llama-3.3-70b-instruct reached end of life on NIM on 2026-08-26)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=

# Alternative: Groq, model llama-3.3-70b-versatile
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# Alternative: any OpenAI-compatible endpoint (Meta Llama API, OpenRouter, ...)
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# JUICY_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional per-role model overrides
# JUICY_TARGET_MODEL=
# JUICY_ATTACKER_MODEL=
# JUICY_JUDGE_MODEL=
# Reasoning effort for reasoning models (default low on NIM): low|medium|high|off
# JUICY_REASONING_EFFORT=low
# Force offline mode
# JUICY_MOCK=1
