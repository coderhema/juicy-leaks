# Copy to .env and fill in. Never commit .env.

# Default provider: NVIDIA NIM (build.nvidia.com), model meta/llama-3.3-70b-instruct
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=

# Alternative: Groq, model llama-3.3-70b-versatile
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# Alternative: any OpenAI-compatible endpoint (Meta Llama API, OpenRouter, ...)
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# GUARDRAIL_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional per-role model overrides
# GUARDRAIL_TARGET_MODEL=
# GUARDRAIL_ATTACKER_MODEL=
# GUARDRAIL_JUDGE_MODEL=
# Force offline mode
# GUARDRAIL_MOCK=1
